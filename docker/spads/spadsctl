#!/usr/bin/env python3
"""Control the SPADS room through the Autopilot plugin's socket.

    spadsctl status                    room, players, bots, game state (JSON)
    spadsctl spads <command>           run a SPADS command with the autohost's
                                       authority, e.g.
                                         spadsctl spads map Comet Catcher Remake 1.8
                                         spadsctl spads set autoAddBotNb 6
                                         spadsctl spads bSet coop 0
                                         spadsctl spads forceStart
                                         spadsctl spads stop
    spadsctl say <text>                say something in the room

From outside the pod:
    kubectl exec -n bar-test deploy/rjm-host-spads -c spads -- spadsctl status

Prints the plugin's one-line JSON answer (pretty-printed) and exits non-zero if
the command was refused.
"""

import json
import os
import socket
import sys


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0 if len(argv) >= 2 else 2
    path = os.environ.get("AUTOPILOT_SOCKET", "/tmp/autopilot.sock")
    line = " ".join(argv[1:]).replace("\n", " ") + "\n"
    try:
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.settimeout(float(os.environ.get("SPADSCTL_TIMEOUT", "15")))
            s.connect(path)
            s.sendall(line.encode("utf-8"))
            data = b""
            while not data.endswith(b"\n"):
                chunk = s.recv(65536)
                if not chunk:
                    break
                data += chunk
    except OSError as exc:
        print(f"spadsctl: cannot reach the Autopilot socket {path}: {exc}", file=sys.stderr)
        return 3
    try:
        reply = json.loads(data.decode("utf-8"))
    except ValueError:
        print(data.decode("utf-8", "replace"), end="")
        return 4
    print(json.dumps(reply, indent=2, sort_keys=True))
    return 0 if reply.get("ok") else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))

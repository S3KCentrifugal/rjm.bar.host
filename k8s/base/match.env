# Match configuration. Consumed as a ConfigMap via envFrom.
#
# Map names are the archive's *versioned* name, which is what GAME\MapName
# resolves through ArchiveScanner::MapNameToMapFile (GameSetup.cpp:679) and what
# pr-downloader --download-map expects.
#
# The rule is ArchiveScanner.cpp:187-196: versioned name = mapinfo `name`, plus
# " " + `version` unless the version already appears in the name. So
# "All That Glitters v2.2.3" (version 2.2.3, already present) keeps its name,
# while "Comet Catcher Remake" (version 1.8) becomes "Comet Catcher Remake 1.8".
# Getting this wrong is a hard failure at load, not a fallback:
#   Fatal: Dependent archive "comet catcher remake" ... not found

# Content. A rapid tag is accepted directly in GAME\Gametype (GameSetup.cpp:668).
# Pin to byar:git:<sha> for a benchmark you want to stay comparable over time;
# byar:test tracks BAR's test branch and will drift under you.
BARHOST_GAMETYPE=byar:test

# Map the match is played on.
BARHOST_MAP=All That Glitters v2.2.3

# Maps the init container fetches. Semicolon-separated. Keep this set small and
# fixed: comparability across AI versions matters more than variety.
BARHOST_MAPS=All That Glitters v2.2.3;Comet Catcher Remake 1.8

# The AI under test. AI_VERSION must match the `version` in its AIInfo.lua,
# which for CircuitAI comes from the VERSION file and is the literal string
# "stable" rather than a number.
BARHOST_AI_SHORTNAME=BARb
BARHOST_AI_VERSION=stable
BARHOST_AI_COUNT=8
BARHOST_ALLYTEAMS=2

# How teams map to allyteams. "interleaved" (team i -> allyteam i % allyTeams)
# matches how BAR maps lay out start positions: All That Glitters, for example,
# alternates them by index, so even-numbered positions are one half of the map
# and odd-numbered the other. With StartPosType 0 the engine hands team i the
# map's position i, so "blocked" (0-3 vs 4-7) would scatter each side across
# both halves and seat every team beside an enemy. Use "blocked" only on a map
# that groups its start positions by side.
BARHOST_TEAM_LAYOUT=interleaved

# "map" leaves start boxes to BAR, which is what standard multiplayer does:
# game_startbox_config.lua takes the map's own layout, falling back to
# north/south or east/west halves picked from the map's aspect ratio when no
# lobby supplies map metadata (startbox_utilities.lua:233).
#
# "auto" or an explicit "l,t,r,b;l,t,r,b" override it. Note that with
# StartPosType other than 2, BAR widens every box to the whole map regardless
# (game_startbox_config.lua:30-40), so an override is silently discarded there.
BARHOST_START_BOXES=map

# Simulation speed multiplier. The supervisor raises the server speed as soon
# as the game starts, so a match completes in a fraction of real time -- this
# is the single biggest lever on iteration speed. The sim is largely
# single-threaded, so the real ceiling is one core's throughput, not this number.
BARHOST_SPEED=20

# Wall-clock budget. On expiry the supervisor asks the server to stop, then
# escalates. A run cut off here is reported as a failure.
BARHOST_TIMEOUT_SECONDS=3600

# 2 = choose-in-game, which is what standard multiplayer uses. BAR assigns any
# team that did not choose -- which is every AI team -- via GuessStartSpot inside
# its allyteam's start box at GameStart (game_initial_spawn.lua:676-699).
#
# 0 and 1 spawn at the map's own start positions in fixed/random order and skip
# start boxes entirely (game_initial_spawn.lua:710-728); 0 is the more
# reproducible choice if you are benchmarking and want identical placement
# across runs, at the cost of not matching how the game is actually played.
BARHOST_STARTPOSTYPE=2

# Resource bonus for every AI team, as a percentage. TeamBase.cpp:59-64 divides
# it by 100 and feeds SetAdvantage, which is SetIncomeMultiplier(value + 1)
# (TeamBase.h:73) -- so 50 means +50% income, matching the lobby's Bonus slider.
BARHOST_AI_HANDICAP=50

# Extra mod options, comma-separated k=v, applied on top of the defaults.
#
# Everything is left at BAR's own default except experimentallegionfaction,
# which run_match.py turns on (modoptions.lua:1855). Set a key to an empty value
# to drop it, e.g. experimentallegionfaction= to play without Legion.
BARHOST_MODOPTIONS=

# Options passed to every AI instance, comma-separated k=v. Maps to the
# [AIn][OPTIONS] block, which CircuitAI reads for its behaviour profile.
BARHOST_AI_OPTIONS=

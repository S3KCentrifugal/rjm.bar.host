# Lobby credentials for the SPADS autohost. Never commit a filled-in copy.
#
# Normally you do not need this file: set the LOBBY_*_TEST / LOBBY_*_PROD
# repository secrets and the deploy job creates this Secret for you
# (docs/setup.md section 5). Use it only to manage the Secret by hand -- and
# then leave those repository secrets unset, or the next deploy overwrites it.
#
#   cp k8s/base/secrets.yaml.example k8s/overlays/test/secrets.yaml   # gitignored
#   # fill in the values, then:
#   kubectl apply -f k8s/overlays/test/secrets.yaml && rm k8s/overlays/test/secrets.yaml
#
# Until the Secret exists the deploy holds SPADS at 0 replicas. Redeploy after
# creating or changing it; SPADS restarts between games, never during one.
apiVersion: v1
kind: Secret
metadata:
  name: rjm-host-secrets
  namespace: bar-test
  labels:
    app.kubernetes.io/name: rjm-host
    app.kubernetes.io/component: secrets
    app.kubernetes.io/part-of: rjm-host
type: Opaque
stringData:
  # The whitelisted secondary account SPADS logs in as.
  SPADS_LOBBY_LOGIN: "<autohost account>"
  SPADS_LOBBY_PASSWORD: "<autohost password>"
  # Your main account: SPADS gives it owner rights (level 140), so it can
  # !addBot, !force and !start by private message. Required -- SPADS refuses to
  # start without it, because an empty owner would make everyone the owner.
  SPADS_OWNER_LOBBY_LOGIN: "<your account>"
  # Room password; "*" makes the room public.
  SPADS_BATTLE_PASSWORD: "<room password>"

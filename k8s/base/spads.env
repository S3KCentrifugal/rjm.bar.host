# SPADS lobby autohost configuration. Consumed as a ConfigMap via envFrom;
# every value is substituted into docker/spads/etc/*.conf by SPADS itself.
# Credentials are NOT here -- they come from the rjm-host-secrets Secret
# (k8s/base/secrets.yaml.example).
#
# Do not set a key to an empty value to mean "default": SPADS substitutes the
# empty string. Delete the line instead.

# Lobby server. BAR's current SPADS configs use server4:8200; TLS is negotiated
# with STARTTLS on the same port (SpringLobbyInterface.pm:1105-1147).
SPADS_LOBBY_HOST=server4.beyondallreason.info
SPADS_LOBBY_PORT=8200

# The UDP port players connect to. The pod uses hostNetwork, so this is a port
# on mcgill-data itself; for internet players the router must forward it (UDP)
# to mcgill-data. The autohost control port is bound to 127.0.0.1 by SPADS.
SPADS_GAME_PORT=8452
SPADS_AUTOHOST_PORT=8454

SPADS_BATTLE_NAME=rjm-host test room

# The game, as a rapid tag SPADS resolves from the content volume. Must be a
# tag fetch-content downloads, i.e. BARHOST_GAMETYPE below.
SPADS_GAME=rapid://byar:test
BARHOST_GAMETYPE=byar:test

# Maps downloaded into the content volume at start (semicolon-separated). The
# room can switch to any map present there (mapList "all").
BARHOST_MAPS=All That Glitters v2.2.3;Comet Catcher Remake 1.8
SPADS_MAP=All That Glitters v2.2.3

# AIs installed before SPADS starts (scripts/install_ai.py), on top of anything
# in the custom-ai volume.
BARHOST_AI_ARCHIVES=github:S3KCentrifugal/CircuitAI@newest

# Which AIs players may add with !addBot, semicolon-separated shortNames. The
# engine picks the highest installed version of each name.
SPADS_ALLOWED_AIS=SMRTBARb;BARb

# Bots the room adds by itself: "<name> <side> <ai>" entries, semicolon-
# separated, used when SPADS_AUTO_ADD_BOTS > 0 (and by `!addBot <name>`).
SPADS_LOCAL_BOTS=SMRTBARb1 0 SMRTBARb;SMRTBARb2 0 SMRTBARb;SMRTBARb3 0 SMRTBARb;SMRTBARb4 0 SMRTBARb;SMRTBARb5 0 SMRTBARb;SMRTBARb6 0 SMRTBARb;SMRTBARb7 0 SMRTBARb;SMRTBARb8 0 SMRTBARb
SPADS_AUTO_ADD_BOTS=0

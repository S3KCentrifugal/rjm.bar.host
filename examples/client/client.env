# `client` mode: a headless lobby client that takes a room on BAR's own
# autohosts and runs AI bots in it. The reference for the mode: docker compose
# (env_file), docker run --env-file, or a Kubernetes ConfigMap (rjm.bar.lobbies
# apps/bar-lobbies). Every key and its default is also documented at the top of
# scripts/lobby_client.py. Leave a key out for its default.
#
# The password is NOT here: client.secrets.env.example.

# The account the client logs in as. One session per account: nothing else may
# be logged in as it, Chobby included. It must have accepted BAR's terms once.
BARHOST_LOBBY_LOGIN=CHANGEME

# follow: wait until a user in BARHOST_FOLLOW is in a room, join it as a
# spectator and bring the bots; that user stays boss, starts the game, and can
# PM the client !bots <n> [AI], !join [password], !leave, !status. BAR's
# server does not tell the client who is in other rooms, so the user may have
# to name the room: !room <room number, host, player or title> [password].
# room: take an empty room on BAR's autohosts and run it alone (below). There
# BARHOST_FOLLOW lists the authorised users: they may PM !public, !private,
# !barb / !smrt (the bots' AI, BARb or SMRTBARb, kept across restarts),
# !bots, !status, are made boss when they join, and votes to unboss them, the
# client, or everyone are ended (!ev).
BARHOST_CLIENT_MODE=follow
BARHOST_FOLLOW=CHANGEME
BARHOST_LOBBY_HOST=server4.beyondallreason.info
BARHOST_LOBBY_PORT=8200

# Which of BAR's autohost regions to take a room from: a regex on the region of
# Host[EU1], Host[US2], ... Unset = any.
BARHOST_LOBBY_CLUSTER=EU

# room mode only: public (an empty Host[..] room) or private (asked of a region
# manager with !privatehost, as Chobby does; the password is PM'd to the
# BARHOST_FOLLOW users). Only the first start uses this: a BARHOST_FOLLOW user
# can PM !public or !private, and the choice is kept in BARHOST_STATE_FILE.
BARHOST_ROOM_PRIVACY=public
# BARHOST_STATE_FILE=/bar/data/lobby-client-state.json
# room mode, public room: the client plays (its seat lets it add bots) until
# this many humans play, then spectates; it plays again when they fall below
# BARHOST_SEAT_PLAY_BELOW. It always spectates once a game is about to start.
BARHOST_SEAT_SPECTATE_AT=8
BARHOST_SEAT_PLAY_BELOW=3

# room mode only: maps to cycle through, one per game, as the autohost's !map
# takes them (';'-separated; a unique part of a name is enough). Applied once
# boss and after every game; the place is kept in BARHOST_STATE_FILE. A map the
# autohost does not switch to within 20 s, or that cannot be downloaded, is
# skipped. Unset = keep whatever map the room has.
# BARHOST_MAP_ROTATION=All That Glitters;All That Simmers;Hera Planum

# room mode only: said privately in the room to each player who joins (only
# they see it). Unset = no welcome.
# BARHOST_WELCOME=Welcome! The AI bots here run on a server, not a player's PC.

# room mode only: room title (!rename), and the commands sent once boss.
BARHOST_ROOM_NAME=Co-op vs 8 BARb (Legion on)
BARHOST_ROOM_SETUP=!preset custom;!bSet experimentallegionfaction 1

# The bots (both modes): owned by this client, so its spectating engine runs them. Humans
# play ally team 0; the bots BARHOST_BOT_ALLY. Sides cycle: 0 Armada,
# 1 Cortex, 3 Legion (stock BARb has no Legion configuration).
BARHOST_BOT_AI=BARb
BARHOST_BOT_COUNT=8
BARHOST_BOT_ALLY=1
BARHOST_BOT_SIDES=0,1
# BARHOST_BOT_PROFILE={"profile":"hard"}

# room mode only: auto-start once this many humans are in, ready and synced.
BARHOST_MIN_HUMANS=1
BARHOST_START_DELAY=20
BARHOST_POSTGAME_DELAY=60

# Content fetched at start, so joining a room needs at most a small update. The
# client downloads whatever game and map the room uses when it joins.
BARHOST_GAMETYPE=byar:test
BARHOST_MAPS=All That Glitters v2.2.3

# A custom AI from a GitHub release, installed at start (then allow it with
# BARHOST_BOT_AI). Stock BARb needs nothing. On a moving tag (@latest: newest
# non-pre-release; @newest: including pre-releases) the client also installs
# a new release between games: after every game, and every
# BARHOST_AI_UPDATE_EVERY seconds while no game runs (0 = never).
# BARHOST_AI_ARCHIVES=github:S3KCentrifugal/CircuitAI@newest
BARHOST_AI_UPDATE_EVERY=900

# `spads` mode: every setting, with its meaning. The reference for the mode:
# docker compose (env_file), docker run --env-file, or a Kubernetes ConfigMap
# (rjm.bar.lobbies apps/bar-spads). Every value is substituted into
# docker/spads/etc/*.conf by SPADS itself.
#
# Credentials are NOT here: spads.secrets.env.example lists them.
#
# Do not set a key to an empty value to mean "default": SPADS substitutes the
# empty string. Delete the line instead.

# Lobby server. BAR's current SPADS configs use server4:8200; TLS is negotiated
# with STARTTLS on the same port (SpringLobbyInterface.pm:1105-1147).
SPADS_LOBBY_HOST=server4.beyondallreason.info
SPADS_LOBBY_PORT=8200

# The UDP port players connect to. The container uses the host's network, so
# this is a port on the host itself, unique per autohost on that host; for
# internet players the router must forward it (UDP) to the host. The autohost
# control port is bound to 127.0.0.1 by SPADS.
SPADS_GAME_PORT=8452
SPADS_AUTOHOST_PORT=8454

SPADS_BATTLE_NAME=rjm-bar-host test room

# The account SPADS logs in as (one session per account) and the owner, who
# gets level 140 and may run any command by private message. Not secret.
SPADS_LOBBY_LOGIN=CHANGEME
SPADS_OWNER_LOBBY_LOGIN=CHANGEME

# The game, as a rapid tag SPADS resolves from the content volume. Must be a
# tag fetch-content downloads, i.e. BARHOST_GAMETYPE below.
SPADS_GAME=rapid://byar:test
BARHOST_GAMETYPE=byar:test

# Maps downloaded into the content volume at start (semicolon-separated). The
# room can switch to any map present there (mapList "all").
BARHOST_MAPS=All That Glitters v2.2.3;Comet Catcher Remake 1.8
SPADS_MAP=All That Glitters v2.2.3

# AIs installed before SPADS starts (scripts/install_ai.py), on top of anything
# in the custom-ai volume.
BARHOST_AI_ARCHIVES=github:S3KCentrifugal/CircuitAI@newest

# Which AIs may run as the autohost's bots, semicolon-separated shortNames.
# The engine picks the highest installed version of each name.
SPADS_ALLOWED_AIS=SMRTBARb;BARb

# Co-op room: humans against a team of server-side bots ("humans vs bots",
# SPADS nbTeams 1). SPADS keeps the bot team at SPADS_AUTO_ADD_BOTS bots, taken
# in order from SPADS_LOCAL_BOTS ("<name> <side> <ai>", side 0 Armada,
# 1 Cortex), and balances every human onto the other team.
SPADS_AUTO_ADD_BOTS=8
SPADS_LOCAL_BOTS=SMRTBARb1 0 SMRTBARb;SMRTBARb2 1 SMRTBARb;SMRTBARb3 0 SMRTBARb;SMRTBARb4 1 SMRTBARb;SMRTBARb5 0 SMRTBARb;SMRTBARb6 1 SMRTBARb;SMRTBARb7 0 SMRTBARb;SMRTBARb8 1 SMRTBARb
SPADS_MAX_HUMANS=8

# Autopilot plugin (docker/spads/plugins/Autopilot.pm): runs the room with no
# operator.
#   BOT_BONUS       income bonus for every bot, percent
#   MIN_HUMANS      players needed before it starts a game (0 = never auto-start)
#   START_DELAY     countdown, seconds, once every player is ready
#   REQUIRE_READY   1 = every player must be ready and synced
#   PREGAME_FORCE   seconds of pre-game, counted once every player has loaded,
#                   before forcing the start (0 = never)
#   PREGAME_MAX     force anyway after this long if a player never finishes loading
AUTOPILOT_BOT_BONUS=50
AUTOPILOT_MIN_HUMANS=1
AUTOPILOT_START_DELAY=20
AUTOPILOT_REQUIRE_READY=1
AUTOPILOT_PREGAME_FORCE=120
AUTOPILOT_PREGAME_MAX=600
# Start boxes for maps BAR's mapBoxes.conf does not know, as !split
# arguments (default "h 25"); set empty to disable.
# AUTOPILOT_DEFAULT_SPLIT=h 25
# The control socket spadsctl talks to (default /tmp/autopilot.sock).
# AUTOPILOT_SOCKET=/tmp/autopilot.sock

# Lobby guard (Autopilot): protects the room from takeover. Boss mode itself
# is owner-only in docker/spads/etc/commands.conf; on top of that the guard
#   - refuses votes on DENY_VOTES commands, votes to kick/ban/spec a protected
#     user (the owner, the autohost, PROTECTED_USERS, anyone at TRUSTED_LEVEL),
#     and !set votes on anything but VOTABLE_SETTINGS;
#   - cancels (!endVote) any such vote that starts anyway;
#   - switches off boss mode held by anyone below TRUSTED_LEVEL;
#   - kicks a user after ABUSE_KICK refused votes within 10 minutes.
# Every attempt is logged, and listed by `spadsctl status` under guard.
AUTOPILOT_GUARD=1
AUTOPILOT_DENY_VOTES=boss,hset,rehost,quit,preset,hpreset,bpreset
AUTOPILOT_VOTABLE_SETTINGS=map
AUTOPILOT_PROTECTED_USERS=
AUTOPILOT_TRUSTED_LEVEL=130
AUTOPILOT_ABUSE_KICK=3
